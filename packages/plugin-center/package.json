{
  "name": "icex-dsh-plugin-center",
  "version": "0.3.16",
  "description": "A sidebar page that installs, updates, enables and removes icex DSH plugins with one click, and keeps them updated automatically.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icexxxxxx/dsh-plugins.git",
    "directory": "packages/plugin-center"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "plugin-manager"
  ]
}
